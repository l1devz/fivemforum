<% const _sz = typeof sz !== 'undefined' ? sz : 40; %><% if (au.avatar_url) { %><img class="av" src="<%= au.avatar_url %>" alt="" width="<%= _sz %>" height="<%= _sz %>" style="width:<%= _sz %>px;height:<%= _sz %>px"><% } else { %><span class="av av-txt" style="width:<%= _sz %>px;height:<%= _sz %>px;font-size:<%= Math.round(_sz*0.38) %>px;--h:<%= hue(au.username) %>"><%= initials(au.username) %></span><% } %>